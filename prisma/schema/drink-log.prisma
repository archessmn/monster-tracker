model DrinkLog {
  id        String   @id @default(cuid(2))
  barcode   String
  datetime  DateTime @default(now())
  latitude  Float?
  longitude Float?

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@map("drink_logs")
}
